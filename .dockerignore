# ---- 版本控制 ----
.git/
.gitignore
.gitattributes

# ---- 密钥 / 环境变量（绝对不能进镜像）----
.env
.env.*
*.env

# ---- Python 缓存与编译产物 ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.eggs/
build/
dist/
*.egg-info/

# ---- uv / 虚拟环境 ----
.venv/
venv/
# 注意：pyproject.toml、uv.lock 必须进入构建上下文，禁止忽略

# ---- 测试与缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 本地开发 / 性能分析产物 ----
test/
performance/
*.prof
*.log

# ---- 编辑器 / IDE ----
.idea/
.vscode/
.trae/

# ---- Docker 自身文件 ----
Dockerfile
docker-compose.yml
.dockerignore

# ---- 文档 ----
*.md
docs/
README*

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
